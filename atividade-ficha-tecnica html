<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,sans-serif;background:#f0e9c0;color:#1a1f2e;line-height:1.6;padding:2rem 1rem 4rem}
.pg{display:none}.pg.active{display:block}
.page{max-width:780px;margin:0 auto;background:#fffdf0;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,.1)}
.hdr{background:#1a5c2e;padding:2rem 2.5rem 1.5rem;border-radius:16px 16px 0 0}
.badge{display:inline-block;background:#c8973a;color:#fff;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;padding:5px 14px;border-radius:20px;margin-bottom:.75rem}
.hdr h1{color:#fff;font-size:26px;font-weight:700}
.meta{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:1.5rem}
.meta label{display:block;color:rgba(255,255,255,.9);font-size:12px;text-transform:uppercase;letter-spacing:.8px;margin-bottom:4px;font-weight:700}
.meta input{width:100%;background:#fff;border:none;border-radius:8px;padding:8px 12px;color:#1a1f2e;font-size:15px;font-family:inherit}
.cnt{padding:2rem 2.5rem}
section{margin-bottom:2rem;border:1px solid #e0e4e8;border-radius:12px;background:#fff;overflow:hidden}
.sh{display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid #e0e4e8}
.s1 .sh{background:#e8f5ec}.s2 .sh{background:#eef2ff}.s3 .sh{background:#1a5c2e}
.s3 .sh h2,.s3 .sh .sub{color:rgba(255,255,255,.85)}
.sh h2{font-size:17px;font-weight:700;color:#1a1f2e}
.sub{font-size:14px;color:#6b7280;margin-left:auto;font-style:italic}
.sb{padding:22px}
.q{margin-bottom:20px}.q:last-child{margin-bottom:0}
.ql{font-size:15px;font-weight:700;color:#374151;margin-bottom:8px}
.qh{font-size:13px;color:#6b7280;margin-bottom:8px;font-style:italic}
textarea{font-family:inherit}
.qi{width:100%;border:1px solid #e0e4e8;border-radius:8px;padding:12px 14px;font-size:16px;color:#1a1f2e;background:#fff;resize:vertical;min-height:70px}
.qi:focus{outline:none;border-color:#4caf70}
.qi-sm{min-height:50px;resize:none}
.etags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px}
.etag{padding:7px 14px;border-radius:20px;border:1.5px solid #e0e4e8;font-size:15px;cursor:pointer;user-select:none;background:#fff;color:#6b7280}
.etag.on{background:#1a5c2e;border-color:#1a5c2e;color:#fff}
.placar{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:18px}
.pi{text-align:center}
.pi-lbl{font-size:13px;color:#6b7280;margin-bottom:4px}
.pi input[type=range]{width:100%;accent-color:#1a5c2e}
.pi-val{font-size:18px;font-weight:700;color:#1a5c2e}
.hbox{background:#fdf3e0;border-left:3px solid #c8973a;border-radius:0 8px 8px 0;padding:12px 16px;margin-bottom:16px;font-size:15px;color:#7c5e1a;font-style:italic}
hr.dv{border:none;border-top:1px solid #e0e4e8;margin:18px 0}

/* MUSIC PLAYER */
#music-player{
  position:fixed;
  bottom:20px;
  right:20px;
  background:#1a5c2e;
  border-radius:50px;
  padding:10px 18px;
  display:flex;
  align-items:center;
  gap:10px;
  box-shadow:0 4px 20px rgba(0,0,0,.35);
  z-index:9999;
  transition:all .3s;
}
#music-player .mp-icon{font-size:20px;animation:spin 3s linear infinite}
@keyframes spin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}
#music-player .mp-label{color:#fff;font-size:12px;font-weight:700;white-space:nowrap;max-width:120px;overflow:hidden;text-overflow:ellipsis}
#music-player .mp-vol-wrap{display:flex;align-items:center;gap:6px}
#music-player .mp-vol-btn{background:rgba(255,255,255,.2);border:none;color:#fff;width:28px;height:28px;border-radius:50%;font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-weight:700;transition:.2s}
#music-player .mp-vol-btn:hover{background:rgba(255,255,255,.35)}
#music-player .mp-vol-val{color:#fff;font-size:13px;font-weight:700;min-width:30px;text-align:center}

/* CAMPO */
.cwrap{background:#1a5c2e;padding-bottom:20px}
.cintro{padding:0 20px 16px}
.cintro p{color:rgba(255,255,255,.75);font-size:12.5px;font-style:italic;border-left:3px solid rgba(255,255,255,.25);padding-left:12px}
.campo{margin:0 20px;background:#1e6b35;border-radius:14px;border:2px solid rgba(255,255,255,.15);min-height:380px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:28px 20px;position:relative}
.campo::before{content:'';position:absolute;left:50%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.12);transform:translateX(-50%)}
.campo::after{content:'';position:absolute;left:50%;top:50%;width:80px;height:80px;border-radius:50%;border:1px solid rgba(255,255,255,.12);transform:translate(-50%,-50%)}
.crow{display:flex;gap:24px;justify-content:center;width:100%;position:relative;z-index:1}
.pcard{display:flex;flex-direction:column;align-items:center;gap:6px}
.av{width:60px;height:60px;border-radius:50%;background:rgba(255,255,255,.15);border:2px solid rgba(255,255,255,.35);display:flex;align-items:center;justify-content:center;font-size:28px;cursor:pointer;position:relative;user-select:none}
.av:hover{border-color:#c8973a;background:rgba(255,255,255,.25)}
.aved{position:absolute;bottom:-2px;right:-2px;width:18px;height:18px;background:#c8973a;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;color:#fff;pointer-events:none}
.pn{background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.5);border-radius:20px;padding:3px 10px;font-size:11px;color:#fff;font-family:inherit;text-align:center;width:90px}
.pn::placeholder{color:rgba(255,255,255,.85)}
.pn:focus{outline:none;border-color:#c8973a}
.pp{font-size:10px;color:rgba(255,255,255,.65);cursor:pointer;padding:4px 10px;border-radius:10px;border:1px solid rgba(255,255,255,.2);background:rgba(0,0,0,.15);white-space:nowrap;text-align:center;user-select:none}
.pp:hover,.pp.ok{border-color:#c8973a;color:#c8973a;background:rgba(200,151,58,.15)}

/* PICKERS — absolutamente fora de qualquer stacking context */
#EP,#PP{
  position:fixed;
  background:#fff;
  border:2px solid #1a5c2e;
  border-radius:12px;
  padding:14px;
  box-shadow:0 12px 40px rgba(0,0,0,.3);
  z-index:2147483647;
  display:none;
  pointer-events:auto;
}
.pt{font-size:11px;color:#6b7280;margin-bottom:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.eg{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;width:216px}
.eb{font-size:24px;border:none;background:transparent;cursor:pointer;border-radius:8px;padding:4px;line-height:1.2}
.eb:hover{background:#f0f0f0}
.pb{display:block;width:100%;text-align:left;background:transparent;border:none;padding:8px 10px;font-size:13px;font-family:inherit;color:#374151;border-radius:8px;cursor:pointer;min-width:220px}
.pb:hover{background:#e8f5ec;color:#1a5c2e}
.pls{font-size:10px;color:#6b7280;display:block}

.nbar{padding:1.5rem 2.5rem 2rem;display:flex;justify-content:flex-end}
.bnx{display:flex;align-items:center;gap:10px;background:#1a5c2e;color:#fff;border:none;border-radius:10px;padding:14px 28px;font-size:16px;font-weight:600;font-family:inherit;cursor:pointer}
.bnx:hover{background:#2e7d45}
.foot{display:flex;align-items:center;justify-content:space-between;padding:16px 2.5rem;border-top:1px solid #e0e4e8;background:#f8f9fa;border-radius:0 0 16px 16px}
.foot span{font-size:13px;color:#6b7280}
.sigs{display:flex;gap:2rem}
.sig{text-align:center}
.sig hr{border:none;border-top:1px solid #ccc;margin-bottom:4px;width:120px}
.sig p{font-size:12px;color:#6b7280}

/* PG2 */
.p2h{background:#1a5c2e;padding:2.5rem 2.5rem 2rem;border-radius:16px 16px 0 0;text-align:center}
.p2b{display:inline-block;background:#c8973a;color:#fff;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;padding:5px 14px;border-radius:20px;margin-bottom:1rem}
.p2h h2{color:#fff;font-size:24px;font-weight:700;margin-bottom:.5rem}
.p2h p{color:rgba(255,255,255,.65);font-size:15px}
.fb{margin:2rem 2.5rem;border:2px solid #e0e4e8;border-radius:16px;overflow:hidden;background:#fff}
.ft{background:#1a5c2e;padding:1.25rem 1.5rem;display:flex;align-items:center;gap:12px}
.ft h3{color:#fff;font-size:17px;font-weight:600}
.ft p{color:rgba(255,255,255,.65);font-size:14px}
.fv{background:linear-gradient(135deg,#f8f4e8,#fdf3e0);padding:1.5rem;border-bottom:1px solid #e0e4e8}
.fvl{font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#c8973a;font-weight:700;margin-bottom:8px}
.fvt{font-size:22px;font-weight:600;color:#1a1f2e;line-height:1.4;font-style:italic;min-height:32px}
.fvt::before{content:'"';color:#c8973a;font-size:30px;line-height:0;vertical-align:-8px;margin-right:4px}
.fvt::after{content:'"';color:#c8973a;font-size:30px;line-height:0;vertical-align:-8px;margin-left:4px}
.rg{display:grid;grid-template-columns:1fr 1fr}
.rc{padding:1.25rem 1.5rem;border-right:1px solid #e0e4e8;border-bottom:1px solid #e0e4e8;background:#fff}
.rc:nth-child(2n){border-right:none}
.rc:nth-last-child(-n+2){border-bottom:none}
.rl{font-size:14px;text-transform:uppercase;letter-spacing:.8px;color:#6b7280;font-weight:700;margin-bottom:8px}
.rv{font-size:16px;color:#374151;line-height:1.6;min-height:20px;white-space:pre-wrap}
.pl2r{display:flex;gap:8px;flex-wrap:wrap}
.pri{text-align:center;background:#f8f9fa;border-radius:8px;padding:8px 12px;min-width:64px}
.pri .pll{font-size:10px;color:#6b7280}
.pri .pvv{font-size:20px;font-weight:700;color:#1a5c2e}
.trw{display:flex;gap:10px;flex-wrap:wrap}
.trj{display:flex;align-items:center;gap:6px;background:#f8f9fa;border-radius:20px;padding:4px 10px 4px 6px}
.ets2{display:flex;flex-wrap:wrap;gap:6px}
.et2{padding:4px 12px;border-radius:20px;background:#1a5c2e;color:#fff;font-size:13px}
.rbox{margin:0 2.5rem 1.5rem;background:linear-gradient(135deg,#e8f5ec,#d4eddf);border-radius:14px;border:1.5px solid #a8d5b5;padding:1.25rem 1.5rem}
.rbox-l{font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#1a5c2e;font-weight:700;margin-bottom:8px}
.rbox-q{font-size:16px;font-weight:600;color:#1a5c2e;margin-bottom:12px}
.rbox textarea{width:100%;background:#fff;border:1px solid #a8d5b5;border-radius:8px;padding:12px 14px;font-size:15px;font-family:inherit;color:#1a1f2e;resize:none;min-height:70px}
.bbar{padding:1.5rem 2.5rem 2rem;display:flex;justify-content:space-between;align-items:center}
.bbk{display:flex;align-items:center;gap:8px;background:transparent;color:#6b7280;border:1px solid #e0e4e8;border-radius:10px;padding:12px 22px;font-size:15px;font-family:inherit;cursor:pointer}
.bpr{display:flex;align-items:center;gap:8px;background:#1a5c2e;color:#fff;border:none;border-radius:10px;padding:12px 22px;font-size:15px;font-family:inherit;cursor:pointer}

/* ═══════════════════════════════════════
   PRINT / PDF  —  contraste e estética
═══════════════════════════════════════ */
@media print {
  /* reset de página */
  @page { margin: 16mm 14mm; size: A4; }

  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }

  body { background: #fff !important; padding: 0 !important; margin: 0 !important; }

  /* esconde elementos de navegação e interação */
  .nbar, .bbar, .bnx, .bbk, .bpr,
  .foot, #EP, #PP,
  input[type=range],
  .aved, .pp { display: none !important; }

  /* mostra as duas páginas empilhadas */
  .pg { display: block !important; }
  #pg2 { page-break-before: always; }

  /* container da página */
  .page {
    max-width: 100% !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    margin: 0 !important;
  }

  /* ── CABEÇALHO VERDE ── */
  .hdr, .p2h {
    background: #1a5c2e !important;
    border-radius: 0 !important;
    padding: 20px 24px 16px !important;
  }
  .hdr h1, .p2h h2 { color: #fff !important; font-size: 18px !important; }
  .badge, .p2b {
    background: #c8973a !important;
    color: #fff !important;
    font-weight: 700 !important;
  }
  .meta label { color: rgba(255,255,255,.95) !important; font-weight: 700 !important; }
  .meta input {
    background: #fff !important;
    color: #000 !important;
    border: 1.5px solid #888 !important;
    border-radius: 6px !important;
    padding: 5px 8px !important;
    font-size: 13px !important;
    font-weight: 600 !important;
  }

  /* ── SEÇÕES ── */
  section, div.fb { break-inside: avoid; }
  .s1 .sh { background: #d4eddf !important; }
  .s2 .sh { background: #dde5fb !important; }
  .s3 .sh, div[style*="background:#1a5c2e"] {
    background: #1a5c2e !important;
  }
  .sh h2 { color: #111 !important; font-weight: 700 !important; font-size: 14px !important; }
  .s3 .sh h2 { color: #fff !important; }
  .sub { color: #444 !important; font-weight: 600 !important; }

  /* ── PERGUNTAS E TEXTO ── */
  .ql { color: #111 !important; font-weight: 700 !important; font-size: 13px !important; }
  .qh { color: #444 !important; font-style: italic !important; }

  /* inputs de texto e textareas — borda visível e texto preto */
  .qi, textarea, .rbox textarea {
    border: 1.5px solid #999 !important;
    color: #000 !important;
    background: #fafafa !important;
    min-height: 50px !important;
    font-size: 13px !important;
  }

  /* ── ETAGS (emoções selecionadas) ── */
  .etag { border: 1.5px solid #bbb !important; color: #555 !important; background: #f5f5f5 !important; font-size: 12px !important; }
  .etag.on { background: #1a5c2e !important; border-color: #1a5c2e !important; color: #fff !important; font-weight: 700 !important; }

  /* ── HBOX (dica laranja) ── */
  .hbox {
    background: #fdf3e0 !important;
    border-left: 3px solid #c8973a !important;
    color: #5a3a00 !important;
    font-weight: 600 !important;
  }

  /* ── PLACAR (sliders → mostra só o valor) ── */
  .pi-lbl { color: #333 !important; font-weight: 700 !important; font-size: 12px !important; }
  .pi-val {
    font-size: 22px !important;
    font-weight: 900 !important;
    color: #1a5c2e !important;
    display: block !important;
  }

  /* ── CAMPO (time de apoio) ── */
  .cwrap { background: #1a5c2e !important; padding-bottom: 16px !important; }
  .campo {
    background: #1e6b35 !important;
    border: 2px solid rgba(255,255,255,.3) !important;
    min-height: 280px !important;
  }
  .cintro p { color: rgba(255,255,255,.9) !important; font-weight: 600 !important; }
  .av {
    background: rgba(255,255,255,.2) !important;
    border: 2px solid rgba(255,255,255,.5) !important;
    font-size: 24px !important;
  }
  .pn {
    background: rgba(255,255,255,.9) !important;
    color: #111 !important;
    border: 1px solid rgba(255,255,255,.7) !important;
    font-weight: 700 !important;
    font-size: 12px !important;
  }

  /* ── PG2 — FICHA FINAL ── */
  .p2h p { color: rgba(255,255,255,.9) !important; font-weight: 600 !important; }
  .ft { background: #1a5c2e !important; }
  .ft h3 { color: #fff !important; font-weight: 700 !important; font-size: 14px !important; }
  .ft p  { color: rgba(255,255,255,.85) !important; font-weight: 600 !important; }

  .fv { background: #fdf3e0 !important; border-bottom: 1.5px solid #ddd !important; }
  .fvl { color: #c8973a !important; font-weight: 800 !important; }
  .fvt { color: #111 !important; font-weight: 700 !important; font-size: 17px !important; }

  .rl { color: #333 !important; font-weight: 800 !important; font-size: 11px !important; }
  .rv { color: #111 !important; font-weight: 500 !important; font-size: 14px !important; }

  .pri { background: #eef5ee !important; border: 1px solid #b0d4b8 !important; }
  .pri .pll { color: #333 !important; font-weight: 700 !important; }
  .pri .pvv { color: #1a5c2e !important; font-weight: 900 !important; font-size: 22px !important; }

  .et2 { background: #1a5c2e !important; color: #fff !important; font-weight: 700 !important; }
  .trj { background: #eef5ee !important; border: 1px solid #b0d4b8 !important; }

  /* reflexão da semana */
  .rbox { background: #eef5ee !important; border: 1.5px solid #a8d5b5 !important; break-inside: avoid; }
  .rbox-l { color: #1a5c2e !important; font-weight: 800 !important; }
  .rbox-q { color: #1a5c2e !important; font-weight: 700 !important; }
  .rbox textarea {
    border: 1.5px solid #999 !important;
    color: #000 !important;
    background: #fff !important;
    min-height: 50px !important;
  }

  /* linha de assinatura */
  .foot { display: flex !important; background: #f8f9fa !important; border-top: 1.5px solid #ccc !important; }
  .sig hr { border-top: 1.5px solid #555 !important; }
  .sig p { color: #333 !important; font-weight: 600 !important; }
  .foot span { color: #555 !important; font-weight: 500 !important; }

  hr.dv { border-top: 1px solid #ccc !important; }
  #manual-btn { display: none !important; }
  #manual-overlay { display: none !important; }
}

/* MANUAL BUTTON — now inline in header */

/* MANUAL OVERLAY */
#manual-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.55);
  z-index: 99999;
  overflow-y: auto;
  padding: 24px 16px 40px;
}
.manual-box {
  max-width: 680px;
  margin: 0 auto;
  background: #fff;
  border-radius: 18px;
  box-shadow: 0 16px 60px rgba(0,0,0,.3);
  overflow: hidden;
}
.manual-hdr {
  background: #1a5c2e;
  padding: 1.5rem 2rem 1.25rem;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.manual-hdr-inner { flex: 1; }
.manual-hdr .m-badge {
  display: inline-block;
  background: #c8973a;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 3px 10px;
  border-radius: 20px;
  margin-bottom: 8px;
}
.manual-hdr h2 {
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  line-height: 1.45;
}
.manual-hdr .m-warn {
  color: rgba(255,255,255,.75);
  font-size: 11.5px;
  font-style: italic;
  margin-top: 5px;
}
.manual-close {
  background: rgba(255,255,255,.2);
  border: none;
  color: #fff;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
}
.manual-close:hover { background: rgba(255,255,255,.35); }
.manual-body { padding: 1.5rem 2rem 2rem; display: flex; flex-direction: column; gap: 16px; }

/* Caixa proposito */
.m-propbox {
  border: 2px solid #1a5c2e;
  border-radius: 12px;
  overflow: hidden;
}
.m-propbox-hdr {
  background: #1a5c2e;
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .7px;
  padding: 8px 16px;
}
.m-propbox-body {
  padding: 14px 16px;
  background: #f0faf4;
  font-size: 13.5px;
  color: #1a1f2e;
  line-height: 1.7;
}
.m-propbox-body strong { color: #1a5c2e; }

/* Caixa sugestão */
.m-sugbox {
  border: 2px solid #c8973a;
  border-radius: 12px;
  overflow: hidden;
}
.m-sugbox-hdr {
  background: #c8973a;
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .7px;
  padding: 8px 16px;
}
.m-sugbox-body {
  padding: 14px 16px;
  background: #fdf8ee;
}
.m-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}
.m-chip {
  background: #1a5c2e;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  padding: 5px 12px;
  border-radius: 20px;
  white-space: nowrap;
}
.m-chip.gold {
  background: #c8973a;
}
.m-num {
