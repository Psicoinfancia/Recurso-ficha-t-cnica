<audio id="bgMusic" loop preload="auto" crossorigin="anonymous">
  <source src="https://livia-430118842660-us-east-1-an.s3.us-east-1.amazonaws.com/The+Official+FIFA+World+Cup+26%E2%84%A2+Theme+-+FIFA+(youtube).mp3" type="audio/mpeg">
</audio>

<script>
var audio = document.getElementById('bgMusic');
var volLevel = 25;
var isPlaying = false;
audio.volume = volLevel / 100;

function showPlayBtn() {
  var btn = document.getElementById('mp-play-btn');
  btn.style.display = 'flex';
  document.getElementById('mp-spin').style.animation = 'none';
  document.getElementById('mp-spin').style.opacity = '.5';
}

function onPlaying() {
  isPlaying = true;
  document.getElementById('mp-play-btn').style.display = 'none';
  document.getElementById('mp-spin').style.animation = '';
  document.getElementById('mp-spin').style.opacity = '1';
}

function userPlay() {
  audio.muted = false;
  audio.volume = volLevel / 100;
  audio.play().then(onPlaying).catch(function(){});
}

function tryAutoplay() {
  // Method 1: muted autoplay then unmute
  audio.muted = true;
  audio.volume = volLevel / 100;
  var p = audio.play();
  if (p !== undefined) {
    p.then(function() {
      audio.muted = false;
      audio.volume = volLevel / 100;
      onPlaying();
    }).catch(function() {
      // Method 2: wait for any user gesture
      showPlayBtn();
      ['click','touchstart','keydown'].forEach(function(ev) {
        document.addEventListener(ev, function handler() {
          if (!isPlaying) {
            audio.muted = false;
            audio.volume = volLevel / 100;
            audio.play().then(onPlaying).catch(function(){});
          }
          document.removeEventListener(ev, handler);
        });
      });
    });
  }
}

function changeVol(delta) {
  volLevel = Math.min(100, Math.max(0, volLevel + delta));
  audio.muted = false;
  audio.volume = volLevel / 100;
  document.getElementById('vol-display').textContent = volLevel + '%';
  if (!isPlaying) { audio.play().then(onPlaying).catch(function(){}); }
}

window.addEventListener('load', tryAutoplay);

var cur = -1;
var EP = document.getElementById('EP');
var PP = document.getElementById('PP');

function openPicker(pop, anchorId, evt) {
  evt.stopPropagation();
  var other = (pop === EP) ? PP : EP;
  other.style.display = 'none';

  if (pop.style.display === 'block') { pop.style.display = 'none'; cur = -1; return; }

  var anchor = document.getElementById(anchorId);
  var r = anchor.getBoundingClientRect();

  // position below-center of anchor first (safe default)
  var L = r.left + r.width/2 - 120;
  var T = r.bottom + 8;

  pop.style.left = Math.max(8, L) + 'px';
  pop.style.top  = T + 'px';
  pop.style.display = 'block';

  // now measure and reposition smartly
  var pw = pop.offsetWidth;
  var ph = pop.offsetHeight;
  var vw = window.innerWidth;
  var vh = window.innerHeight;

  // prefer right of anchor
  L = r.right + 10;
  T = r.top;
  if (L + pw > vw - 8) { L = r.left - pw - 10; }   // try left
  if (L < 8)           { L = Math.max(8, r.left + r.width/2 - pw/2); T = r.bottom + 8; } // fall below
  // vertical clamp
  if (T + ph > vh - 8) T = vh - ph - 8;
  if (T < 8)           T = 8;

  pop.style.left = L + 'px';
  pop.style.top  = T + 'px';
}

// Wire up avatars
for (var i = 0; i < 4; i++) {
  (function(idx){
    document.getElementById('av'+idx).addEventListener('click', function(e){ cur=idx; openPicker(EP,'av'+idx,e); });
    document.getElementById('pp'+idx).addEventListener('click', function(e){ cur=idx; openPicker(PP,'pp'+idx,e); });
  })(i);
}

EP.addEventListener('click', function(e){ e.stopPropagation(); });
PP.addEventListener('click', function(e){ e.stopPropagation(); });
document.addEventListener('click', function(){ EP.style.display='none'; PP.style.display='none'; cur=-1; });

function setEmoji(e) {
  if (cur < 0) return;
  document.getElementById('em'+cur).textContent = e;
  EP.style.display = 'none';
}
function setPos(p) {
  if (cur < 0) return;
  var el = document.getElementById('pp'+cur);
  el.textContent = p;
  el.classList.add('ok');
  PP.style.display = 'none';
}

function goP2() {
  var nome = document.getElementById('f-nome').value.trim();
  document.getElementById('p2sub').textContent = nome ? 'Resumo da sessão — '+nome : 'Resumo da sessão';
  function fill(id,v){ document.getElementById(id).textContent=v||'—'; }
  fill('r2-final',  document.getElementById('r-final').value.trim());
  fill('r2-mudar',  document.getElementById('r-mudar').value.trim());
  fill('r2-melhora',document.getElementById('r-melhora').value.trim());
  fill('r2-atrapalha',document.getElementById('r-atrapalha').value.trim());
  fill('r2-fortes', document.getElementById('r-fortes').value.trim());
  fill('r2-pensamentos',document.getElementById('r-pensamentos').value.trim());

  var tags=document.querySelectorAll('#etags .etag.on');
  var eEl=document.getElementById('r2-emocoes'); eEl.innerHTML='';
  if(tags.length){ var w=document.createElement('div');w.className='ets2';
    tags.forEach(function(t){var s=document.createElement('span');s.className='et2';s.textContent=t.textContent;w.appendChild(s);}); eEl.appendChild(w);
  } else eEl.textContent='—';

  var areas=[{id:'sl-escola',l:'🏫 Escola'},{id:'sl-familia',l:'🏠 Família'},{id:'sl-amizades',l:'👫 Amizades'},{id:'sl-humor',l:'😊 Humor'},{id:'sl-sono',l:'😴 Sono'}];
  var pEl=document.getElementById('r2-placar'); pEl.innerHTML='';
  areas.forEach(function(a){var d=document.createElement('div');d.className='pri';d.innerHTML='<div class="pll">'+a.l+'</div><div class="pvv">'+document.getElementById(a.id).value+'</div>';pEl.appendChild(d);});

  var tEl=document.getElementById('r2-time'); tEl.innerHTML=''; var any=false;
  for(var i=0;i<4;i++){
    var n=document.getElementById('pn'+i).value.trim();
    if(n){any=true;var em=document.getElementById('em'+i).textContent;var pos=document.getElementById('pp'+i).textContent;
      var d=document.createElement('div');d.className='trj';
      d.innerHTML='<span style="font-size:18px">'+em+'</span><div><div style="font-weight:600;font-size:11px;color:#1a1f2e">'+n+'</div><div style="font-size:10px;color:#6b7280">'+(pos!=='escolher posição'?pos:'')+'</div></div>';
      tEl.appendChild(d);}
  }
  if(!any) tEl.textContent='—';

  document.getElementById('pg1').classList.remove('active');
  document.getElementById('pg2').classList.add('active');
  window.scrollTo(0,0);
}
function goP1(){ document.getElementById('pg2').classList.remove('active'); document.getElementById('pg1').classList.add('active'); window.scrollTo(0,0); }
</script>
